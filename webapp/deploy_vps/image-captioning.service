[Unit]
Description=Image Captioning Web App (Flask + model C)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/image-captioning/webapp
Environment=STUDY_TAG=mobilenet_v3_clip
Environment=USE_V3=1
Environment=USE_CLIP=1
Environment=HF_HOME=/opt/image-captioning/.cache/huggingface
Environment=HF_HUB_CACHE=/opt/image-captioning/.cache/huggingface/hub
Environment=PORT=5000
ExecStart=/opt/image-captioning/.venv/bin/python /opt/image-captioning/webapp/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target